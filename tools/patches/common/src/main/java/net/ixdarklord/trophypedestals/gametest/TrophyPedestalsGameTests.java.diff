+    private static int countMobTrophies(ServerPlayer player) {
+        int count = 0;
+        for (int slot = 0; slot < player.getInventory().getContainerSize(); slot++) {
+            if (player.getInventory().getItem(slot).has(Pedestals.MOB_TROPHY.get())) count++;
+        }
+        return count;
+    }
