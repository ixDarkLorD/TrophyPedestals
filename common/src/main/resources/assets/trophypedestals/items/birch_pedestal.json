{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "trophypedestals:pedestal",
    "on_true": {
      "type": "minecraft:composite",
      "models": [
        {
          "type": "minecraft:model",
          "model": "trophypedestals:item/birch_pedestal_trophy"
        },
        {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": "gui",
              "model": {
                "type": "minecraft:special",
                "base": "trophypedestals:item/birch_pedestal_trophy",
                "model": {
                  "type": "trophypedestals:trophy_icon"
                }
              }
            }
          ],
          "fallback": {
            "type": "minecraft:special",
            "base": "trophypedestals:item/birch_pedestal_trophy",
            "model": {
              "type": "trophypedestals:trophy_icon",
              "spin": true
            }
          }
        }
      ]
    },
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "trophypedestals:mob_trophy",
      "on_true": {
        "type": "minecraft:composite",
        "models": [
          {
            "type": "minecraft:model",
            "model": "trophypedestals:item/birch_pedestal_trophy"
          },
          {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": "gui",
                "model": {
                  "type": "minecraft:special",
                  "base": "trophypedestals:item/birch_pedestal_trophy",
                  "model": {
                    "type": "trophypedestals:trophy_icon"
                  }
                }
              }
            ],
            "fallback": {
              "type": "minecraft:special",
              "base": "trophypedestals:item/birch_pedestal_trophy",
              "model": {
                "type": "trophypedestals:trophy_icon",
                "spin": true
              }
            }
          }
        ]
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "trophypedestals:block/birch_pedestal"
      }
    }
  }
}
