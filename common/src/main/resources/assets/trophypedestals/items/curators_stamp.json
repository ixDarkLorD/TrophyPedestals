{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "settings",
              "model": {
                "type": "minecraft:model",
                "model": "trophypedestals:item/curators_stamp_settings"
              }
            },
            {
              "when": "lens",
              "model": {
                "type": "minecraft:model",
                "model": "trophypedestals:item/curators_stamp_lens"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "trophypedestals:item/curators_stamp_trimmed"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "trophypedestals:item/curators_stamp_trimmed"
    }
  }
}
